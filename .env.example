# =============================================================================
# COBRO DIARIO — Configuración de entorno (raíz del monorepo)
# Copia este archivo a `.env` y ajusta los valores.
#   cp .env.example .env
#
# CLOUD-READY: para migrar a la nube (RDS, Supabase, Neon, Railway, etc.)
# solo cambia DATABASE_URL / REDIS_URL. Nada más en el código depende del host.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL
# Local (Docker Compose): usa el host `localhost` y el puerto expuesto abajo.
# Nube: reemplaza toda la DATABASE_URL por la cadena de tu proveedor.
# -----------------------------------------------------------------------------
POSTGRES_USER=cobradiario
POSTGRES_PASSWORD=cobradiario_dev_pwd
POSTGRES_DB=cobradiario
POSTGRES_PORT=5432

# RUNTIME: la app usa `app_user` (mínimos privilegios, NO superusuario) para que RLS aplique.
DATABASE_URL="postgresql://app_user:app_user_pwd@localhost:5432/cobradiario?schema=public&connection_limit=20&pool_timeout=20"
# MIGRACIONES / seed / admin: dueño de las tablas (crea schema, rol app_user y políticas RLS).
DIRECT_URL="postgresql://cobradiario:cobradiario_dev_pwd@localhost:5432/cobradiario?schema=public"

# -----------------------------------------------------------------------------
# Redis (Pub/Sub para GraphQL subscriptions + Socket.IO adapter + caché + colas)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# API (NestJS GraphQL)
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
GRAPHQL_PLAYGROUND=true
CORS_ORIGINS="http://localhost:3000,exp://127.0.0.1:19000"

# -----------------------------------------------------------------------------
# Autenticación / JWT
# Genera secretos fuertes: `openssl rand -base64 48`
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CAMBIA_ESTO_access_secret_dev_only
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CAMBIA_ESTO_refresh_secret_dev_only
JWT_REFRESH_TTL=1209600
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Notificaciones push (Expo). En prod usar credenciales reales / FCM+APNs.
# -----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Observabilidad (opcional)
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
