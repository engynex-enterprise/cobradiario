# ==========================================================================
# Cobro Diario · backend (NestJS). Copia a .env y completa los valores.
# ==========================================================================

# --- Base de datos (PostgreSQL / InsForge) ---
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host:5432/db?sslmode=require

# --- Redis (BullMQ + WebSocket). En Compute va embebido en el contenedor. ---
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
# Orígenes permitidos (CORS), separados por coma. Vacío = permitir todos.
CORS_ORIGINS=https://tu-web.insforge.site
GRAPHQL_PLAYGROUND=false
LOG_LEVEL=info

# URL pública de la web (para enlaces de correo: verificación, invitaciones).
WEB_APP_URL=https://tu-web.insforge.site

# --- JWT ---
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo
JWT_REFRESH_TTL=1209600
BCRYPT_ROUNDS=12

# --- InsForge Storage (subida de imágenes KYC) ---
INSFORGE_URL=https://tu-proyecto.insforge.app
INSFORGE_API_KEY=ik_xxxxxxxxxxxxxxxx
INSFORGE_BUCKET=client-kyc

# ==========================================================================
# CORREO (transaccional). Elige UN proveedor con MAIL_PROVIDER.
#   MAIL_PROVIDER = smtp | resend | sendgrid
#   MAIL_FROM     = remitente mostrado, ej: Cobro Diario <noreply@tudominio.com>
# ==========================================================================
MAIL_PROVIDER=smtp
MAIL_FROM=Cobro Diario <noreply@tudominio.com>

# --- Opción A: SMTP (Gmail, Brevo, o el SMTP de Resend/SendGrid) ---
# Gmail:    host=smtp.gmail.com  port=465  user=tucorreo  pass=contraseña-de-app
# Brevo:    host=smtp-relay.brevo.com  port=587
# Resend:   host=smtp.resend.com  port=465  user=resend  pass=RESEND_API_KEY
# SendGrid: host=smtp.sendgrid.net port=465  user=apikey  pass=SENDGRID_API_KEY
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Opción B: Resend por API (MAIL_PROVIDER=resend) ---
RESEND_API_KEY=

# --- Opción C: SendGrid por API (MAIL_PROVIDER=sendgrid) ---
SENDGRID_API_KEY=
