{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/**/*.e2e-spec.ts"],
  "transform": { "^.+\\.ts$": "ts-jest" },
  "setupFiles": ["<rootDir>/env-setup.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 30000
}
